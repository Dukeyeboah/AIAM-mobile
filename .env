# Expo Environment Variables
# Note: In Expo, use EXPO_PUBLIC_ prefix for variables that need to be accessible in the app
# Server-side variables (like API keys) should NOT be exposed to the client
# For mobile apps, API calls should go through your web app's API routes

# Your web app's API URL - this is what the mobile app will call
EXPO_PUBLIC_API_URL=https://www.aiam.space

# Note: The following keys are used server-side in your Next.js web app
# They should NOT be in the mobile app's .env file for security
# The mobile app calls your web app's API routes, which use these keys server-side:
# - OPENAI_API_KEY
# - REPLICATE_API_TOKEN
# - ELEVENLABS_API_KEY
# - RESEND_API_KEY
# - STRIPE_SECRET_KEY
# - FIREBASE_PRIVATE_KEY

# Firebase config is already in src/firebase.ts (client-side config is safe)
